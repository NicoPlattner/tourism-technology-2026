# Server-only values. Never use VITE_ prefixes for credentials.
CAPTION_PROVIDER=openai
CAPTION_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
CAPTION_BASE_URL=
OPENAI_BASE_URL=https://api.openai.com/v1
CAPTION_TIMEOUT_MS=8000
CAPTION_MAX_OUTPUT_TOKENS=350
CAPTION_JSON_MODE=json_schema
CAPTION_PORT=8787
CAPTION_RATE_LIMIT=30

# For n8n: set CAPTION_PROVIDER=n8n and configure Header Auth on this webhook.
CAPTION_N8N_WEBHOOK_URL=
CAPTION_N8N_AUTH_HEADER=X-Caption-Key
CAPTION_N8N_AUTH_PREFIX=
CAPTION_API_KEY=
