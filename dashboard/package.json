{
  "name": "paznaun-demand-radar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Demand Radar for TVB Paznaun-Ischgl \u2014 overnight stays, forecast and bed capacity explained (TTF Hackathon 2026, challenge 04)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && mkdir -p ../helm/tourism-technology/api && cp server/server.mjs server/analytics.mjs ../helm/tourism-technology/api/",
    "preview": "vite preview",
    "data:open": "node scripts/fetch-open-data.mjs",
    "data:sample": "node scripts/make-sample-data.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test tests/campaign-data.test.ts",
    "test": "playwright test",
    "server": "node server/server.mjs",
    "test:server": "node --test server/server.test.mjs"
  },
  "dependencies": {
    "d3-array": "3.2.4",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/d3-array": "3.2.1",
    "@types/d3-scale": "4.0.8",
    "@types/d3-shape": "3.1.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "tsx": "^4.23.15",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
